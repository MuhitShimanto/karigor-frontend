# Backend API URL (server-side calls and BFF proxy target)
BACKEND_API_URL=http://localhost:5000/api

# Public frontend application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe publishable key (test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_key

# Authentication Cookie Name
AUTH_COOKIE_NAME=karigor_token

# Optional JWT secret for edge middleware verification
JWT_SECRET=super_secret_jwt_key_min_16_chars
